# Copia este archivo como .env y pega tus keys. El archivo .env nunca se sube a git.

# Obligatoria. Key gratuita de OpenRouteService (rutas y búsqueda de direcciones).
ORS_API_KEY=

# Opcional. Key de TomTom para medir el tráfico del momento. Si la dejas vacía,
# la app funciona igual pero sin datos de tráfico.
TOMTOM_API_KEY=

# Puerto local. Abre http://localhost:3000
PORT=3000

# Usa 0.0.0.0 solo si quieres abrir la app desde tu celular en la misma red Wi-Fi.
HOST=localhost
